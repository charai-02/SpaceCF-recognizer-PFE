   <string notr="true">*{
	border: none;
	background-color: transparent;
	background: transparent;
	padding: 0;
	margin: 0;
	color: rgb(0, 0, 0);
}

#centralwidget{
	background-color: rgb(211, 211, 211);
	background-image:url('backgrounds/wallpaperflare.com_wallpaper(22).jpg');
}

#leftMenuSubContainer{
	background-color: rgb(130, 28, 255);
}

#leftMenuSubContainer QPushButton{
	text-align: left;
	padding: 5px 10px;
	border-top-left-radius: 10px;
	border-bottom-left-radius: 10px;
}



#centerMenuSubContainer{
	background-color: rgb(175, 175, 175);
}

#frame_4, #popupNotificationSubContainer, #frame_11, #screenshotBtn, #changeScreenshotBtn{
	background-color: rgb(0, 115, 255);
	border-radius: 5px;
}

#headerContainer, #footerContainer{
	background-color: rgb(175, 175, 175);
}

#label_11{
	background-color: rgb(175, 175, 175);
	border-radius: 15px;
	border-width: 10px;
	border-color:  rgb(0, 175, 175);
}
#label_12{

}

#recognizeBtn , #screenShotBtn , #addBtn, #clearDataBtn,  #cancelBtn{
	color: rgb(255, 255, 255);
	background-color: rgb(126, 140, 130);
	border-radius:20px;
}

#addPersonTitle{
	color: rgb(255, 255, 255);
}

